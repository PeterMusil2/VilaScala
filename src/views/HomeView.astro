---
import { Image } from 'astro:assets';

import exteriorEvening from '../assets/images/exterior-evening.jpg';
import vilaScalaDay from '../assets/images/vila-scala-day.png';
import vilaScalaNight from '../assets/images/vila-scala-night.png';
import garage1 from '../assets/images/garage-1.jpg';
import viewSvratka from '../assets/images/view-svratka.jpg';
import veslarskaCorridor from '../assets/images/veslarska-corridor.jpg';
import veslarskaWineCellar from '../assets/images/veslarska-wine-cellar.png';

import Button from '../components/Button.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Gallery from '../components/Gallery.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import UnitCard from '../components/UnitCard.astro';
import VideoHero from '../components/VideoHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

import { site } from '../data/site';
import { units } from '../data/units';
import { path, t, withBase, siteRoot, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const c = dict.home;
const cs = locale === 'cs';

const galleryItems = [
  { src: viewSvratka, alt: cs ? 'Výhled na meandr řeky Svratky' : 'View over the meander of the Svratka river' },
  { src: garage1, alt: cs ? 'Podzemní garáž viladomu s vozem Porsche' : 'The underground garage with a Porsche' },
  { src: veslarskaCorridor, alt: cs ? 'Chodba s podsvícenými kamennými panely' : 'Corridor with illuminated stone panels' },
  { src: veslarskaWineCellar, alt: cs ? 'Vinotéka vytesaná ve skále' : 'Wine cellar carved into the rock' },
];

const priced = units.filter((u) => typeof u.price === 'number');
const activeUnits = units.filter((u) => u.status !== 'sold');
const availableCount = units.filter((u) => u.status === 'available').length;
const availableCountLabel = cs
  ? availableCount === 1
    ? '1 volný byt'
    : availableCount >= 2 && availableCount <= 4
      ? `${availableCount} volné byty`
      : `${availableCount} volných bytů`
  : `${availableCount} available ${availableCount === 1 ? 'apartment' : 'apartments'}`;
const heroFacts = c.heroFacts.map((fact, index) =>
  index === 1
    ? {
        label: cs ? 'Aktuální nabídka' : 'Available now',
        value: availableCountLabel,
      }
    : fact,
);

const schema = [
  {
    '@type': 'ApartmentComplex',
    '@id': `${siteRoot()}#project`,
    name: site.name,
    description: c.seoDescription,
    numberOfAccommodationUnits: units.length,
    numberOfAvailableAccommodationUnits: units.filter((u) => u.status === 'available').length,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.street,
      addressLocality: `${site.city}-${site.district}`,
      postalCode: site.postalCode,
      addressCountry: site.country,
    },
    geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
    amenityFeature: [
      { '@type': 'LocationFeatureSpecification', name: cs ? 'Vinotéka ve skále' : 'Wine cellar in the rock', value: true },
      { '@type': 'LocationFeatureSpecification', name: cs ? 'Prosklený výtah' : 'Glass lift', value: true },
      { '@type': 'LocationFeatureSpecification', name: cs ? 'Podlahové vytápění' : 'Underfloor heating', value: true },
      { '@type': 'LocationFeatureSpecification', name: cs ? 'Garážové stání' : 'Garage parking', value: true },
    ],
    ...(priced.length
      ? {
          offers: {
            '@type': 'AggregateOffer',
            priceCurrency: 'CZK',
            lowPrice: Math.min(...priced.map((u) => u.price!)),
            highPrice: Math.max(...priced.map((u) => u.price!)),
            offerCount: priced.length,
            availability: 'https://schema.org/InStock',
          },
        }
      : {}),
  },
];
---

<BaseLayout
  locale={locale}
  routeKey="home"
  title={c.seoTitle}
  description={c.seoDescription}
  image={withBase("/og/home.jpg")}
  imageAlt={c.heroPosterAlt}
  schema={schema}
  overHero
>
  <VideoHero
    locale={locale}
    eyebrow={c.heroEyebrow}
    titleLines={[...c.heroTitleLines]}
    subtitle={c.heroSubtitle}
    posterAlt={c.heroPosterAlt}
    facts={heroFacts}
  >
    <Button href={path('units', locale)}>{dict.cta.viewUnits}</Button>
    <Button
      href={site.homeVirtualTourUrl}
      variant="onDark"
      external
    >
      {dict.cta.virtualTour}
    </Button>
  </VideoHero>

  <!-- The decision surface comes first: buyers can see what is actionable
       before reading the longer project story. -->
  <Section id="byty" tone="surface" labelledby="units-title" class="home-availability">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
      <SectionHeading
        id="units-title"
        index="01"
        eyebrow={dict.nav.units}
        title={c.unitsTitle}
        lead={c.unitsSubtitle}
      />
      <div class="reveal hidden lg:block" data-reveal-delay="120">
        <Button href={path('units', locale)} variant="secondary">{dict.cta.viewUnits}</Button>
      </div>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:mt-8 lg:grid-cols-3">
      {activeUnits.map((unit, index) => <UnitCard locale={locale} unit={unit} eager={index === 0} index={index} />)}
    </div>

    <div class="reveal mt-8 lg:hidden">
      <Button href={path('units', locale)} variant="secondary" class="w-full">{dict.cta.viewUnits}</Button>
    </div>
  </Section>

  <!-- Intro: text column with a figure breaking into the gutter ---------- -->
  <Section labelledby="intro-title" class="home-intro lg:!py-6">
    <SectionHeading
      id="intro-title"
      index="02"
      eyebrow={dict.nav.about}
      title={c.introTitle}
      titleClass="lg:!text-[clamp(2.75rem,7vh,3.25rem)]"
    >
      <div class="home-intro-copy reveal prose-vs mt-7 text-lg text-muted lg:mt-4 lg:text-base lg:leading-[1.55]" data-reveal-delay="120">
        {c.introBody.map((para) => <p>{para}</p>)}
        <p class="text-base">{c.introStudios}</p>
        <div class="mt-8 flex flex-wrap gap-3 lg:mt-4">
          <Button href={path('about', locale)} variant="secondary">{dict.nav.about}</Button>
          <Button href={path('pricing', locale)} variant="ghost">{dict.cta.priceList}</Button>
        </div>
      </div>

      <div slot="aside" class="bleed-end flex items-start justify-center lg:justify-end" data-reveal-delay="200">
        <BeforeAfter
          before={vilaScalaDay}
          after={vilaScalaNight}
          beforeAlt={cs
            ? 'Vila SCALA ve dne'
            : 'Vila SCALA during the day'}
          afterAlt={cs
            ? 'Vila SCALA v noci s rozsvícenými interiéry'
            : 'Vila SCALA at night with illuminated interiors'}
          beforeLabel={cs ? 'Den' : 'Day'}
          afterLabel={cs ? 'Noc' : 'Night'}
          controlLabel={cs
            ? 'Porovnat denní a noční pohled na Vila SCALA'
            : 'Compare the day and night views of Vila SCALA'}
          imageClass="object-bottom"
          class="mx-auto !aspect-[1038/1518] w-full max-w-[28rem] lg:mx-0 lg:h-[min(78vh,620px)] lg:w-[min(34vw,430px)] lg:max-w-full lg:!aspect-auto"
        />
      </div>
    </SectionHeading>
  </Section>

  <!-- Proof points: concise project facts after the core story. ---------- -->
  <Section tone="surface" labelledby="stats-title">
    <h2 id="stats-title" class="sr-only">{c.statsTitle}</h2>
    <dl class="grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        c.stats.map((stat, i) => (
          <div class="reveal border-t border-line-strong pt-6" data-reveal-delay={i * 80}>
            <dt class="meta text-muted">{stat.label}</dt>
            <dd>
              <span class="mt-4 block font-display text-[clamp(3.5rem,7vw,6rem)] leading-[0.85] text-accent-text lg:text-[clamp(3.25rem,7vh,5.25rem)]">
                {stat.value}
              </span>
              <span class="mt-4 block text-sm text-muted">{stat.detail}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <!-- Highlights: two-column editorial list ------------------------------ -->
  <Section labelledby="highlights-title">
    <SectionHeading id="highlights-title" index="03" eyebrow={site.name} title={c.highlightsTitle} />
    <ul class="mt-12 grid border-t border-line sm:grid-cols-2 lg:mt-8">
      {
        c.highlights.map((h, i) => (
          <li
            class="reveal border-b border-line py-7 sm:odd:pr-10 sm:even:border-l sm:even:pl-10 lg:py-5"
            data-reveal-delay={(i % 2) * 80}
          >
            <p class="meta text-accent-text">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-4 text-h3 lg:mt-3">{h.title}</h3>
            <p class="mt-3 max-w-md text-muted lg:mt-2">{h.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- Gallery ------------------------------------------------------------ -->
  <Section labelledby="gallery-title">
    <SectionHeading
      id="gallery-title"
      index="04"
      eyebrow={dict.unitsPage.galleryTitle}
      title={c.galleryTitle}
      lead={c.gallerySubtitle}
    />
    <Gallery locale={locale} items={galleryItems} variant="balanced" class="mt-12 lg:mt-8" />
  </Section>

  <!-- Closing CTA over the evening exterior ------------------------------ -->
  <section class="relative isolate overflow-hidden bg-[#0b0908] text-[#f6f2ec]" aria-labelledby="cta-title">
    <Image
      src={exteriorEvening}
      alt=""
      widths={[640, 1024, 1600]}
      sizes="100vw"
      loading="lazy"
      class="absolute inset-0 -z-20 size-full object-cover"
    />
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[#0b0908]/78"></div>

    <div class="container-page py-24 sm:py-28 lg:py-[clamp(4rem,12vh,7rem)]">
      <div class="reveal max-w-3xl">
        <p class="meta text-[#f6f2ec]/60">05</p>
        <h2 id="cta-title" class="mt-5 text-h2 lg:mt-4">{c.ctaTitle}</h2>
        <p class="mt-5 max-w-xl text-lg text-[#f6f2ec]/85 lg:mt-4">{c.ctaBody}</p>
        <div class="mt-8 flex flex-wrap gap-3 lg:mt-6">
          <Button href={path('contact', locale)}>{dict.cta.contactUs}</Button>
          <Button
            href={site.homeVirtualTourUrl}
            variant="onDark"
            external
          >
            {dict.cta.virtualTour}
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
