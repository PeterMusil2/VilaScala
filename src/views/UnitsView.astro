---
import pageHeroView from '../assets/images/page-hero-view.webp';
import entranceNumber from '../assets/images/entrance-number.jpg';
import unit1Day from '../assets/images/unit-1-day.jpeg';
import unit1Night from '../assets/images/unit-1-night.jpeg';
import unit2Day from '../assets/images/unit-2-day-01.webp';
import unit2Night from '../assets/images/unit-2-night-01.webp';
import unit3Day from '../assets/images/unit-3-day-01.jpeg';
import unit3Night from '../assets/images/unit-3-night-01.jpeg';

import Breadcrumbs from '../components/Breadcrumbs.astro';
import Button from '../components/Button.astro';
import Gallery from '../components/Gallery.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import UnitIndex from '../components/UnitIndex.astro';
import UnitsTable from '../components/UnitsTable.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

import { units } from '../data/units';
import { path, t, withBase, absolute, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const c = dict.unitsPage;

const cs = locale === 'cs';
const galleryItems = [
  { src: unit1Day, alt: cs ? 'Byt 1039/1 — denní vizualizace' : 'Apartment 1039/1 — daytime visualisation' },
  { src: unit1Night, alt: cs ? 'Byt 1039/1 — noční vizualizace' : 'Apartment 1039/1 — night-time visualisation' },
  { src: unit2Day, alt: cs ? 'Byt 1039/2 — denní vizualizace' : 'Apartment 1039/2 — daytime visualisation' },
  { src: unit2Night, alt: cs ? 'Byt 1039/2 — noční vizualizace' : 'Apartment 1039/2 — night-time visualisation' },
  { src: unit3Day, alt: cs ? 'Byt 1039/3 — denní vizualizace' : 'Apartment 1039/3 — daytime visualisation' },
  { src: unit3Night, alt: cs ? 'Byt 1039/3 — noční vizualizace' : 'Apartment 1039/3 — night-time visualisation' },
  { src: entranceNumber, alt: cs ? 'Vstup do domu s číslem 144 na Veslařské ulici' : 'Entrance to number 144 on Veslařská street' },
];

const floorplans = units.map((u) => ({
  src: u.plan,
  alt: `${dict.units.floorplan} — ${dict.units.labelUnit} ${u.number}, ${u.layout}`,
}));

const schema = [
  {
    '@type': 'ItemList',
    name: c.title,
    numberOfItems: units.length,
    itemListElement: units.map((u, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: absolute(path('unit', locale, u.slug)),
      name: `${dict.units.labelUnit} ${u.number} — ${u.layout}`,
    })),
  },
];
---

<BaseLayout
  locale={locale}
  routeKey="units"
  title={c.seoTitle}
  description={c.seoDescription}
  image={withBase("/og/home.jpg")}
  schema={schema}
  overHero
>
  <Hero
    image={pageHeroView}
    alt={cs
      ? 'Výhled do zeleně a na okolí od Vily SCALA'
      : 'View across the greenery and surroundings from Vila SCALA'}
    title={c.title}
    subtitle={c.lead}
  />

  <Breadcrumbs locale={locale} trail={[]} current={dict.nav.units} />

  <Section labelledby="units-intro-title" class="pt-10 sm:pt-14">
    <h2 id="units-intro-title" class="sr-only">{c.lead}</h2>
    <div class="grid gap-x-12 gap-y-10 md:grid-cols-2">
      {
        c.introSections.map((s, i) => (
          <article class="reveal border-t border-line-strong pt-7" data-reveal-delay={i * 80}>
            <h3 class="text-2xl">{s.title}</h3>
            <p class="mt-4 text-muted">{s.body}</p>
          </article>
        ))
      }
    </div>
    <p class="reveal prose-vs mt-10 text-lg text-muted">{c.introClosing}</p>
  </Section>

  <Section tone="surface" labelledby="units-list-title">
    <SectionHeading id="units-list-title" index="01" eyebrow={dict.nav.units} title={c.tableTitle} />

    <!-- One comparison surface per viewport: tactile rows on small screens,
         aligned figures on desktop. Avoid showing the same inventory twice. -->
    <UnitIndex locale={locale} class="mt-14 lg:hidden" />
    <UnitsTable locale={locale} class="mt-14 hidden lg:block" />
  </Section>

  <Section labelledby="floorplans-title">
    <SectionHeading id="floorplans-title" index="02" eyebrow={dict.nav.documents} title={c.floorplansTitle} />
    <Gallery locale={locale} items={floorplans} variant="grid" fit="contain" class="mt-12" />
    <div class="reveal mt-10">
      <Button href={path('documents', locale)} variant="secondary">{dict.cta.allDocuments}</Button>
    </div>
  </Section>

  <Section tone="surface" labelledby="units-gallery-title">
    <SectionHeading id="units-gallery-title" index="03" eyebrow={dict.meta.siteName} title={c.galleryTitle} />
    <Gallery locale={locale} items={galleryItems} variant="balanced" class="mt-12" />
  </Section>
</BaseLayout>
