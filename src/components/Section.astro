---
interface Props {
  id?: string;
  /** Renders a tinted band instead of the page background. */
  tone?: 'default' | 'surface';
  class?: string;
  labelledby?: string;
}
const { id, tone = 'default', class: className = '', labelledby } = Astro.props;
---

<section
  id={id}
  aria-labelledby={labelledby}
  class:list={[
    'py-16 sm:py-20 lg:py-[clamp(1.75rem,3.75vh,3.5rem)]',
    tone === 'surface' && 'border-y border-line bg-surface',
    className,
  ]}
>
  <div class="container-page"><slot /></div>
</section>
