---
export interface Props {
  id?: string;
  /** Two-digit index printed in the margin, editorial style. */
  index?: string;
  eyebrow?: string;
  title: string;
  lead?: string;
  as?: 'h1' | 'h2';
  tone?: 'default' | 'invert';
  titleClass?: string;
}
const { id, index, eyebrow, title, lead, as: Tag = 'h2', tone = 'default', titleClass = '' } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<div>
  {
    (index || eyebrow) && (
      <p
        class:list={[
          'reveal meta flex items-center gap-3',
          tone === 'invert' ? 'text-white/60' : 'text-muted',
        ]}
      >
        {index && <span class="text-accent-text">{index}</span>}
        {index && eyebrow && <span aria-hidden="true" class="h-px w-8 bg-current opacity-40" />}
        {eyebrow && <span>{eyebrow}</span>}
      </p>
    )
  }

  <div
    class:list={[
      (index || eyebrow) && 'mt-5 lg:mt-4',
      hasAside && 'grid gap-10 md:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] md:items-start lg:gap-12',
    ]}
  >
    <div class="max-w-4xl">
      <Tag id={id} class:list={[Tag === 'h1' ? 'text-display' : 'text-h2', titleClass]}>
        <span class="reveal-line"><span>{title}</span></span>
      </Tag>
      {
        lead && (
          <p
            class:list={[
              'reveal mt-5 max-w-2xl text-lg sm:text-xl lg:mt-4',
              tone === 'invert' ? 'text-white/80' : 'text-muted',
            ]}
            data-reveal-delay="120"
          >
            {lead}
          </p>
        )
      }
      <slot />
    </div>
    {hasAside && <slot name="aside" />}
  </div>
</div>
