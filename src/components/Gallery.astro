---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import { t, type Locale } from '../i18n';

export interface GalleryItem {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  locale: Locale;
  items: GalleryItem[];
  /** Masonry-ish editorial grid, a plain even grid, or a balanced photo grid. */
  variant?: 'editorial' | 'grid' | 'balanced';
  /**
   * Photographs are cropped to a common rhythm; drawings must never be —
   * a cropped floor plan is a wrong floor plan.
   */
  fit?: 'cover' | 'contain';
  class?: string;
}

const {
  locale,
  items,
  variant = 'editorial',
  fit = 'cover',
  class: className = '',
} = Astro.props;
const dict = t(locale);

// Full-resolution (but still optimised) sources for the lightbox.
const full = await Promise.all(
  items.map((item) =>
    getImage({ src: item.src, format: 'webp', quality: 82, width: Math.min(item.src.width, 2000) }),
  ),
);

// A repeating rhythm that keeps the grid interesting without art-directing
// every single tile by hand.
const spans = ['sm:col-span-4', 'sm:col-span-2', 'sm:col-span-2', 'sm:col-span-4', 'sm:col-span-3', 'sm:col-span-3'];
---

<div
  data-gallery
  class:list={[
    'grid gap-3 sm:gap-4',
    variant === 'editorial'
      ? 'sm:grid-cols-6'
      : variant === 'balanced'
        ? 'sm:grid-cols-2 sm:gap-x-5 sm:gap-y-8'
        : 'grid-cols-2 lg:grid-cols-3',
    className,
  ]}
>
  {
    items.map((item, i) => (
      <figure
        class:list={['reveal group relative m-0', variant === 'editorial' && spans[i % spans.length]]}
        data-reveal-delay={(i % 3) * 70}
      >
        <a
          href={full[i].src}
          data-fancybox="vila-gallery"
          data-caption={item.alt}
          data-alt={item.alt}
          data-width={full[i].attributes.width ?? item.src.width}
          data-height={full[i].attributes.height ?? item.src.height}
          class="button-link block w-full cursor-zoom-in overflow-hidden rounded-card bg-surface"
          aria-label={`${dict.a11y.openGallery}: ${item.alt}`}
        >
          <Image
            src={item.src}
            alt={item.alt}
            widths={[400, 700, 1000, 1400]}
            sizes="(min-width: 1024px) 40vw, (min-width: 640px) 50vw, 92vw"
            loading="lazy"
            decoding="async"
            quality={62}
            class:list={[
              'w-full transition-transform duration-500 ease-[var(--ease-out-soft)] motion-reduce:transition-none motion-reduce:group-hover:scale-100',
              variant === 'balanced' ? 'h-auto' : 'aspect-[4/3]',
              fit === 'contain'
                ? 'bg-elevated object-contain p-2 group-hover:scale-[1.015]'
                : 'object-cover group-hover:scale-[1.03]',
            ]}
          />
        </a>
        <figcaption class:list={[variant === 'balanced' ? 'mt-3 text-sm text-muted' : 'sr-only']}>
          {item.alt}
        </figcaption>
      </figure>
    ))
  }
</div>
